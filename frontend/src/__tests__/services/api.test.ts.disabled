import { gameService } from '../../services/api';
import { server } from '../../mocks/server';
import { rest } from 'msw';

const API_BASE_URL = 'http://localhost:8000';

describe('API Service', () => {
  describe('getTodaysGames', () => {
    test('fetches today\'s games successfully', async () => {
      const games = await gameService.getTodaysGames();

      expect(Array.isArray(games)).toBe(true);
      expect(games).toHaveLength(1);
      expect(games[0]).toHaveProperty('id');
      expect(games[0]).toHaveProperty('home_team');
      expect(games[0]).toHaveProperty('away_team');
    });

    test('handles API errors', async () => {
      // Override the handler to return an error
      server.use(
        rest.get(`${API_BASE_URL}/api/games/today`, (req, res, ctx) => {
          return res(ctx.status(500), ctx.json({ error: 'Internal server error' }));
        })
      );

      await expect(gameService.getTodaysGames()).rejects.toThrow();
    });

    test('handles network errors', async () => {
      // Override the handler to simulate network error
      server.use(
        rest.get(`${API_BASE_URL}/api/games/today`, (req, res, ctx) => {
          return res.networkError('Network error');
        })
      );

      await expect(gameService.getTodaysGames()).rejects.toThrow();
    });
  });

  describe('getAllGamesWithBets', () => {
    test('fetches all games with best bets', async () => {
      const games = await gameService.getAllGamesWithBets();

      expect(Array.isArray(games)).toBe(true);
      expect(games[0]).toHaveProperty('best_bets');
      expect(Array.isArray(games[0].best_bets)).toBe(true);
    });

    test('returns games with betting data', async () => {
      const games = await gameService.getAllGamesWithBets();

      const firstGame = games[0];
      expect(firstGame.best_bets).toHaveLength(2);
      expect(firstGame.best_bets[0]).toHaveProperty('confidence');
      expect(firstGame.best_bets[0]).toHaveProperty('expected_value');
      expect(firstGame.best_bets[0]).toHaveProperty('reasoning');
    });
  });

  describe('getGameOdds', () => {
    test('fetches odds for specific game', async () => {
      const odds = await gameService.getGameOdds('mock_game_001');

      expect(Array.isArray(odds)).toBe(true);
      expect(odds[0]).toHaveProperty('sportsbook');
      expect(odds[0]).toHaveProperty('bet_type');
      expect(odds[0]).toHaveProperty('odds');
    });

    test('handles non-existent game', async () => {
      await expect(gameService.getGameOdds('nonexistent_game'))
        .rejects.toThrow();
    });
  });

  describe('getBestBets', () => {
    test('fetches best bets for specific game', async () => {
      const bets = await gameService.getBestBets('mock_game_001');

      expect(Array.isArray(bets)).toBe(true);
      expect(bets[0]).toHaveProperty('bet_type');
      expect(bets[0]).toHaveProperty('confidence');
      expect(bets[0]).toHaveProperty('reasoning');
    });

    test('validates best bet structure', async () => {
      const bets = await gameService.getBestBets('mock_game_001');

      const firstBet = bets[0];
      expect(typeof firstBet.confidence).toBe('number');
      expect(firstBet.confidence).toBeGreaterThanOrEqual(0);
      expect(firstBet.confidence).toBeLessThanOrEqual(1);
      expect(typeof firstBet.expected_value).toBe('number');
      expect(typeof firstBet.reasoning).toBe('string');
    });
  });

  describe('getCompleteGameData', () => {
    test('fetches complete game data', async () => {
      const gameData = await gameService.getCompleteGameData('mock_game_001');

      expect(gameData).toHaveProperty('id');
      expect(gameData).toHaveProperty('odds');
      expect(gameData).toHaveProperty('best_bets');
      expect(Array.isArray(gameData.odds)).toBe(true);
      expect(Array.isArray(gameData.best_bets)).toBe(true);
    });

    test('returns complete data structure', async () => {
      const gameData = await gameService.getCompleteGameData('mock_game_001');

      // Verify all required game fields
      expect(gameData).toHaveProperty('home_team');
      expect(gameData).toHaveProperty('away_team');
      expect(gameData).toHaveProperty('scheduled_time');
      expect(gameData).toHaveProperty('status');
      expect(gameData).toHaveProperty('arena');
    });
  });

  describe('healthCheck', () => {
    test('performs health check successfully', async () => {
      const health = await gameService.healthCheck();

      expect(health).toHaveProperty('status');
      expect(health.status).toBe('healthy');
      expect(health).toHaveProperty('service');
    });
  });

  describe('Request Interceptors', () => {
    test('logs API requests', async () => {
      const consoleSpy = jest.spyOn(console, 'log').mockImplementation();

      await gameService.getTodaysGames();

      expect(consoleSpy).toHaveBeenCalledWith(
        expect.stringMatching(/API Request: GET/)
      );

      consoleSpy.mockRestore();
    });

    test('handles response errors', async () => {
      const consoleErrorSpy = jest.spyOn(console, 'error').mockImplementation();

      server.use(
        rest.get(`${API_BASE_URL}/api/games/today`, (req, res, ctx) => {
          return res(ctx.status(404), ctx.json({ error: 'Not found' }));
        })
      );

      try {
        await gameService.getTodaysGames();
      } catch (error) {
        // Expected to throw
      }

      expect(consoleErrorSpy).toHaveBeenCalled();
      consoleErrorSpy.mockRestore();
    });
  });

  describe('API Configuration', () => {
    test('uses correct base URL', () => {
      // Test that the service is configured with correct URL
      // This is more of an integration test
      expect(API_BASE_URL).toBe('http://localhost:8000');
    });

    test('has appropriate timeout', async () => {
      // Test timeout behavior
      server.use(
        rest.get(`${API_BASE_URL}/api/games/today`, (req, res, ctx) => {
          return res(ctx.delay(15000)); // 15 second delay
        })
      );

      const startTime = Date.now();

      try {
        await gameService.getTodaysGames();
      } catch (error) {
        const endTime = Date.now();
        const duration = endTime - startTime;

        // Should timeout before 15 seconds (our service timeout is 10 seconds)
        expect(duration).toBeLessThan(15000);
      }
    });
  });
});