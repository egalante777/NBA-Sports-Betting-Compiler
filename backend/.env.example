# NBA Sports Betting Compiler - Environment Configuration Template
#
# Copy this file to .env and fill in your actual values
# Get your API key from https://the-odds-api.com/

# REQUIRED: The Odds API Key for betting odds
ODDS_API_KEY=your_api_key_here

# OPTIONAL: Enable prop bets (uses 4x more API credits)
# Set to "true" to include player/team prop bets in analysis
# WARNING: This significantly increases API credit consumption
ENABLE_PROP_BETS=false

# DEVELOPMENT: Enable mock playoff scenario for testing/demos
# Set to "true" to show Knicks vs Cavaliers playoff game with analysis
ENABLE_DEV_PLAYOFF_MODE=false